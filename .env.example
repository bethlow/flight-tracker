# Copy to .env for local use. NEVER commit .env.
DATABASE_URL=postgresql://app:app@localhost/flights
JWT_SECRET=change-me-to-a-long-random-string   # generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ENV=dev   # lets the app start with a throwaway secret on your own machine only

# Google Calendar sync (optional -- leave unset to skip the feature entirely).
# Create an OAuth client at console.cloud.google.com -> APIs & Services -> Credentials
# (type "Web application"), enable the Google Calendar API, and add the redirect URI below
# to the client's "Authorized redirect URIs".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
